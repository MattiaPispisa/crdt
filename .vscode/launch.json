{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🐕 🐦 greyhound_markdown",
      "cwd": "apps/greyhound_markdown/client",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=GREYHOUND_WS=wss://greyhound-markdown-server.mattia-pispisa.workers.dev"
      ]
    },
    {
      "name": "🐕 🐦 greyhound_markdown [DEV]",
      "cwd": "apps/greyhound_markdown/client",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=GREYHOUND_WS=ws://localhost:8787"
      ]
    },
    {
      "name": "🐕 🖥️ greyhound_markdown server [wrangler]",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/greyhound_markdown/server",
      "command": "npx wrangler dev"
    },
    {
      "name": "🐕 🖥️ greyhound_markdown server [dart_frog]",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/greyhound_markdown/server_dart_frog",
      "command": "fvm exec dart_frog dev --port 8787"
    },
    {
      "name": "🐕 🖥️ greyhound_markdown server [serverpod]",
      "cwd": "apps/greyhound_markdown/server_serverpod",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/apps/greyhound_markdown/server_serverpod/bin/main.dart"
    },
    {
      "name": "[crdt_lf] flutter_example",
      "cwd": "packages/core/crdt_lf/flutter_example",
      "request": "launch",
      "type": "dart",
      "args": []
    },
    {
      "name": "[crdt_lf] devtools_extension",
      "cwd": "packages/core/crdt_lf_devtools_extension",
      "request": "launch",
      "type": "dart",
      "args": ["--dart-define=use_simulated_environment=true"]
    },
    {
      "name": "[crdt_socket_sync] server",
      "cwd": "packages/core/crdt_socket_sync/example",
      "request": "launch",
      "type": "dart",
      "args": []
    },
    {
      "name": "[crdt_socket_sync] client",
      "cwd": "packages/core/crdt_socket_sync/client_example",
      "request": "launch",
      "type": "dart",
      "args": []
    },
    {
      "name": "[crdt_lf_flutter] example",
      "cwd": "packages/core/crdt_lf_flutter/example",
      "request": "launch",
      "type": "dart",
      "args": []
    }
  ]
}
