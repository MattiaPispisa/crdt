# The only ignore file of the workspace: packages, apps and docs have none.

# FVM Version Cache
.fvm/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
.cursor/
migrate_working_dir/

# Lock files: pubspec.lock is committed in every package, others are not.
*.lock
!pubspec.lock

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Visual Studio Code related: only the workspace root folder is committed
.classpath
.project
.settings/
.ccls-cache
/packages/**/.vscode/
/apps/**/.vscode/

# Flutter/Dart/Pub related
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
**/generated_plugin_registrant.dart
.packages
.pub-preload-cache/
.pub-cache/
.pub/
build/
coverage/
flutter_*.png

# Dart Frog
.dart_frog/

# Android related
**/android/**/gradle-wrapper.jar
.gradle/
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
**/android/app/debug
**/android/app/profile
**/android/app/release
*.jks
*.keystore
local.properties
**/.cxx/

# iOS/XCode related
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/*sync/
**/ios/**/.sconsign.dblite
**/ios/**/.tags*
**/ios/**/.vagrant/
**/ios/**/DerivedData/
**/ios/**/Icon?
**/ios/**/Pods/
**/ios/**/.symlinks/
**/ios/**/profile
**/ios/**/xcuserdata
**/ios/.generated/
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*
**/dgph

# macOS
**/Flutter/ephemeral/
**/Pods/
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/macos/Flutter/ephemeral
**/xcuserdata/

# Windows
**/windows/flutter/ephemeral/
**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugin_registrant.h
**/windows/flutter/generated_plugins.cmake
**/windows/**/*.suo
**/windows/**/*.user
**/windows/**/*.userosscache
**/windows/**/*.sln.docstates
**/windows/**/x64/
**/windows/**/x86/
**/windows/**/*.[Cc]ache
!**/windows/**/*.[Cc]ache/

# Linux
**/linux/flutter/ephemeral/
**/linux/flutter/generated_plugin_registrant.cc
**/linux/flutter/generated_plugin_registrant.h
**/linux/flutter/generated_plugins.cmake

# Symbols
app.*.symbols
app.*.map.json

# Exceptions to above rules.
!**/ios/**/default.mode1v3
!**/ios/**/default.mode2v3
!**/ios/**/default.pbxuser
!**/ios/**/default.perspectivev3

# Node.js (docs/, apps/greyhound_markdown/server/)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Files the examples write at runtime
**/example/db/
**/example/*.db
**/example/*.crdt

# Generated by scripts/flutter_example_bs.dart (melos bootstrap post hook)
/packages/core/crdt_lf/flutter_example/assets/
/packages/_internal/shared_examples_infrastructure/assets/
/apps/greyhound_markdown/client/assets/
/apps/greyhound_markdown/client/web/favicon.png
/apps/greyhound_markdown/client/web/icons/

# Docs site (Docusaurus)
/docs/build/
/docs/static/
/docs/.docusaurus/
/docs/.cache-loader/
# Copied by docs_bs
/docs/docs/documentation/packages/*.md
/docs/docs/contributing.md

# Greyhound markdown relay (Cloudflare Worker)
/apps/greyhound_markdown/server/.wrangler/
/apps/greyhound_markdown/server/.dev.vars

# AI related
**/.agents/rules/personal-*
**/.agents/skills/personal-*
.agent-shell/
.claude/
CLAUDE.md
CLAUDE.local.md
.mcp.json
